# Public application and Firebase web configuration (identifiers, not secrets)
NEXT_PUBLIC_APP_ORIGIN=http://localhost:3000
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-math-study-buddy
NEXT_PUBLIC_FIREBASE_APP_ID=
# Set only for local development against the Auth emulator
NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_URL=http://127.0.0.1:9099

# Server-only Firebase Admin configuration.
# Locally, leave the key pair empty and point at the emulators; in production use
# App Hosting's application-default credentials or a service-account key pair.
FIREBASE_PROJECT_ID=demo-math-study-buddy
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_STORAGE_BUCKET=demo-math-study-buddy.appspot.com
SESSION_COOKIE_DAYS=14

# Emulator hosts (unset in production)
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199

# Durable jobs
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# OpenAI — pin exact supported model IDs after running the evaluation set
OPENAI_API_KEY=
SOLVER_MODEL_ID=
CHECKER_MODEL_ID=
TUTOR_MODEL_ID=
CLASSIFIER_MODEL_ID=
RERANKER_MODEL_ID=

# Voyage embeddings
VOYAGE_API_KEY=
VOYAGE_MODEL_ID=voyage-3
VOYAGE_DIMENSION=1024

# Math Stack Exchange
STACK_EXCHANGE_KEY=
MSE_CACHE_TTL_SECONDS=86400

# MathNET release and local importer input
MATHNET_DATASET_ID=ShadenA/MathNet
MATHNET_RELEASE_REVISION=
MATHNET_SOURCE_FILE=
MATHNET_FIXTURE_LIMIT=300
# "index" (Firestore vector search, requires deployed vector indexes) or "exact"
# (in-memory scan; use with the emulator and for recall checks on small catalogs)
MATHNET_VECTOR_MODE=index

# Per-account AI limits
DAILY_TOKEN_LIMIT=400000
MAX_CONCURRENT_AI_JOBS=2
