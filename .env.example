# Public application and Supabase browser configuration
NEXT_PUBLIC_APP_ORIGIN=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only Supabase service-role/secret key
SUPABASE_SECRET_KEY=

# Durable jobs
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Anthropic — pin exact supported model IDs after running the evaluation set
ANTHROPIC_API_KEY=
SOLVER_MODEL_ID=
CHECKER_MODEL_ID=
TUTOR_MODEL_ID=
CLASSIFIER_MODEL_ID=
RERANKER_MODEL_ID=

# Voyage embeddings
VOYAGE_API_KEY=
VOYAGE_MODEL_ID=voyage-3
VOYAGE_DIMENSION=1024

# Math Stack Exchange
STACK_EXCHANGE_KEY=
MSE_CACHE_TTL_SECONDS=86400

# MathNET release and local importer input
MATHNET_DATASET_ID=ShadenA/MathNet
MATHNET_RELEASE_REVISION=
MATHNET_SOURCE_FILE=
MATHNET_FIXTURE_LIMIT=300

# Per-account AI limits
DAILY_TOKEN_LIMIT=400000
MAX_CONCURRENT_AI_JOBS=2
