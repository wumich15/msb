rules_version = '2';

// Math Study Buddy — Firestore access rules.
//
// The browser never talks to Firestore directly. Every read and write goes
// through the Next.js API routes, which verify the session cookie, derive the
// owner on the server, and run the atomic transactions in src/lib/db/transactions.
// The Admin SDK bypasses these rules; client SDKs are denied everywhere, so a
// browser client can never reach another account's records, the private
// reference_solutions / mathnet_solution_data collections, or set a job or
// preparation state itself.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
