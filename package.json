{
  "name": "math-study-buddy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "mathnet:inspect": "tsx scripts/mathnet-inspect.ts",
    "mathnet:import": "tsx scripts/mathnet-import.ts",
    "mathnet:index": "tsx scripts/mathnet-build-index.ts",
    "evals:run": "tsx scripts/run-evals.ts",
    "inngest:dev": "inngest-cli dev",
    "emulators": "firebase emulators:start --only auth,firestore,storage --project demo-math-study-buddy",
    "test:integration": "firebase emulators:exec --only firestore --project demo-math-study-buddy \"vitest run --config vitest.integration.config.ts\"",
    "firebase:deploy:rules": "firebase deploy --only firestore:rules,firestore:indexes,storage"
  },
  "dependencies": {
    "dompurify": "^3.4.15",
    "inngest": "^4.20.0",
    "jszip": "^3.10.2",
    "katex": "^0.18.7",
    "marked": "^18.0.13",
    "next": "^16.3.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5",
    "firebase": "^12.19.0",
    "firebase-admin": "^14.4.0",
    "openai": "^7.15.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@playwright/test": "^1.63.0",
    "@types/dompurify": "^3.0.5",
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.5",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0",
    "@firebase/rules-unit-testing": "^5.0.2"
  }
}
